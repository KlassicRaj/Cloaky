# Local development values. In Render set NODE_ENV=production and use the PORT
# supplied by the platform; the server binds to 0.0.0.0.
NODE_ENV=development
PORT=3000

# Render PostgreSQL supplies DATABASE_URL. Never commit database credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/visitor_routing
# Render Key Value supplies REDIS_URL (redis:// or rediss://). Redis stores
# rate-limit and frequency state only; PostgreSQL remains the source of truth.
REDIS_URL=redis://localhost:6379

# Keep the admin username configured after provisioning. ADMIN_PASSWORD_HASH
# is needed only for the one-time npm run admin:provision command.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# In production use separate random values of at least 32 bytes for these
# secrets. Enter them only in the hosting provider's secret environment.
SESSION_SECRET=
IP_HASH_SECRET=

# Optional path to an externally supplied GeoLite2-City.mmdb file. Do not put
# the database or its license credentials in this file or the Docker image.
GEOIP_DATABASE_PATH=

# Use the final public HTTPS service URL in production. BASE_URL is not used as
# a redirect destination; redirects come from validated project rules.
BASE_URL=http://localhost:3000

# COOKIE_SECURE must be true when NODE_ENV=production.
COOKIE_SECURE=false
# Configure proxy IP/CIDRs only for the actual trusted proxy path.
TRUSTED_PROXIES=

# Optional operational limits (the defaults shown are used when unset).
EVENT_RETENTION_DAYS=30
RATE_LIMIT_PER_MINUTE=60

# The following are only for local docker-compose.prod.yml, not Render. Render
# supplies DATABASE_URL and REDIS_URL directly; do not use Compose service URLs.
# Use URL-safe random passwords for the local Compose stack.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
APP_PORT=3000
GEOIP_DATABASE_DIR=./data/geoip